# =========================================================
# MediTrust 3-Cloud Zero-Trust Platform Environment Config
# =========================================================

# Node Environment
NODE_ENV=development

# Cloud A: AWS Identity & Auth Gateway
CLOUD_A_PORT=5001
JWT_SECRET=zero-trust-multi-cloud-secret-key-2026
JWT_EXPIRES_IN=24h

# Inter-Service Cloud URLs (for local simulation or cloud VPCs)
CLOUD_B_URL=https://localhost:5002
CLOUD_C_URL=https://localhost:5003

# Cloud B: GCP Patient & EHR Service
CLOUD_B_PORT=5002
REQUIRE_MTLS=true

# Cloud C: Azure Appointments & Audit Service
CLOUD_C_PORT=5003

# Certificate & mTLS Cryptography Paths (relative or absolute)
CA_CERT_PATH=../../certs/ca.crt
CLOUD_A_CERT_PATH=../../certs/cloudA.crt
CLOUD_A_KEY_PATH=../../certs/cloudA.key
CLOUD_B_CERT_PATH=../../certs/cloudB.crt
CLOUD_B_KEY_PATH=../../certs/cloudB.key
CLOUD_C_CERT_PATH=../../certs/cloudC.crt
CLOUD_C_KEY_PATH=../../certs/cloudC.key

# Frontend URL
FRONTEND_PORT=3000
VITE_CLOUD_A_URL=http://localhost:5001

# Optional Database Connection URIs (if migrating from in-memory to DB)
# MONGODB_URI=mongodb://localhost:27017/meditrust_zerotrust
